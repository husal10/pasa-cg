<configuration>
  <input>
    <net-file value="grid2x2.net.xml"/>
    <route-files value="grid2x2.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="0.1"/>
  </time>
  <report>
    <no-step-log value="true"/>
    <no-warnings value="true"/>
  </report>
</configuration>
